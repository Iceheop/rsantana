---
interface Props {
    src: string;
    description: string;
    title: string;
    tags: string[];
    url: string;
    slug?: string;
}

const { src, description, title, tags, url, slug } = Astro.props;
---

<article>
    <section class="ratio ratio-16x9 overflow-hidden rounded-3">
        <img src={src} alt={description} class="img-fluid" loading="lazy">
    </section>
    <section class="pt-4">
        <div class="d-flex align-items-start justify-content-between gap-3 mb-2">
            <div>
                <h2 class="fs-5 fw-bold mb-1">{title}</h2>
                <p class="fs-6 mb-0">{description}</p>
            </div>
            <div class="d-flex align-items-center gap-1 flex-shrink-0">
                {url && (
                    <a
                        href={url}
                        class="btn btn-sm d-inline-flex align-items-center justify-content-center fs-4"
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Abrir la web de ${title}`}
                        title="Abrir web"
                    >
                        <i class="bi bi-link-45deg" aria-hidden="true"></i>
                    </a>
                )}
                {slug && (
                    <a
                        href={`/projects/${slug}`}
                        class="btn btn-sm d-inline-flex align-items-center justify-content-center fs-4"
                        aria-label={`Ver la documentación de ${title}`}
                        title="Ver detalle"
                    >
                        <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                    </a>
                )}
            </div>
        </div>
        {tags && tags.length > 0 && (
            <div class="d-flex flex-nowrap gap-2 mt-2 overflow-auto pb-1">
                {tags.map((tag: string) => (
                    <span class="badge px-3 py-2 rounded-pill text-bg-dark text-nowrap">{tag}</span>
                ))}
            </div>
        )}
    </section>
</article>

